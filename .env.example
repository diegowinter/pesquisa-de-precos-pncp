# Configuração da pipeline itens-contratos-atas v2. Copie para .env e ajuste.

# ── PostgreSQL (Fase 2) ──────────────────────────────────────────────────────
# Fonte da verdade a partir da Fase 2. Se ausente, vale o default de `db/sessao.py`
# (postgres:postgres@localhost:5432/pesquisa_precos). É a MESMA URL usada pelo Alembic —
# não existe uma segunda no alembic.ini, de propósito.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pesquisa_precos

# ── OpenRouter (pago) — OpenAI-compatible ────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_PASS1=            # barato: classificação, extração PDF (ex.: google/gemini-2.0-flash-001)
OPENAI_MODEL_PASS2=            # forte: confirmação de curadoria, validação de pares (ex.: openai/gpt-4o)

# ── LM Studio (local, OpenAI-compatible) ─────────────────────────────────────
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=                   # modelo pequeno p/ classificação (etapas 0b-pass1 e 3)
LOCAL_API_KEY=lm-studio        # dummy

# ── OCR local (servidor OpenAI-compatible) ───────────────────────────────────
OCR_BASE_URL=http://localhost:8000/v1
OCR_MODEL=
OCR_API_KEY=ocr

# ── Modelos em processo (sentence-transformers) ──────────────────────────────
EMBEDDER_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Thresholds (calibráveis; ver ferramentas/calibrar_thresholds.py) ─────────
REJEITOR_THRESHOLD=0.30        # 6a: cosseno/BM25 mínimo p/ par sobreviver (recall ~99%)
RERANK_T_ACEITA=0.80           # 6b: score do reranker p/ aceitar direto
RERANK_T_REJEITA=0.30          # 6b: score do reranker p/ rejeitar direto
MIN_ITENS=5                    # regra dos 5
TOP_N=5                        # top N mais baratos por código

# ── Notificações (Fase 9) — Telegram bot + e-mail via Resend, best-effort ────
# Etapa concluída / falhou / gate aguardando (services/notificacoes.py, runner/processo.py).
# QUEM recebe é cadastrado pela interface web (/notificacoes, CRUD de
# notificacao_destinatario) — aqui só ficam as CREDENCIAIS.
# Telegram: crie um bot com @BotFather. TELEGRAM_CHAT_ID é só fallback (usado se ainda não
# houver nenhum destinatário cadastrado).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Resend (e-mail): https://resend.com — API key e remetente verificado no domínio do Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
