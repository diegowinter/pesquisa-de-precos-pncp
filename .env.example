# Configuração do pipeline. Copie para .env e ajuste.
# Este é o .env de QUEM ORQUESTRA. Os serviços pesados (GPU, OCR, PDF, pareamento)
# têm o .env deles, no repositório `../pncp-servicos-locais` — ADR-021.

# ── PostgreSQL (Fase 2) ──────────────────────────────────────────────────────
# Fonte da verdade a partir da Fase 2. Se ausente, vale o default de `db/sessao.py`
# (postgres:postgres@localhost:5432/pesquisa_precos). É a MESMA URL usada pelo Alembic —
# não existe uma segunda no alembic.ini, de propósito.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pesquisa_precos

# ── OpenRouter (pago) — OpenAI-compatible ────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_PASS1=            # barato: classificação, extração PDF (ex.: google/gemini-2.0-flash-001)
OPENAI_MODEL_PASS2=            # forte: confirmação de curadoria, validação de pares (ex.: openai/gpt-4o)

# ── LM Studio (local, OpenAI-compatible) ─────────────────────────────────────
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=                   # modelo pequeno p/ classificação (etapas 0b-pass1 e 3)
LOCAL_API_KEY=lm-studio        # dummy

# ── Serviços de `pncp-servicos-locais` (ADR-019/ADR-021) ─────────────────────
# Vazio NÃO é "roda aqui": é erro de configuração, e a etapa para antes de começar. Este
# processo baixa, orquestra e grava no banco — GPU e CPU intensiva ficam do outro lado.
GPU_BASE_URL=http://localhost:8100        # serviço `gpu`  — rerank da 6b
GPU_API_KEY=gpu
PDF_BASE_URL=                             # serviço `pdf`  — parse + rasterização + OCR (5)
PDF_API_KEY=pdf
PAREAMENTO_BASE_URL=                      # serviço `pareamento` — BM25 + cosseno + corte (6a)
PAREAMENTO_API_KEY=pareamento

# `OCR_*` NÃO fica aqui: quem chama o OCR é o serviço de `pdf`, e é no .env DELE que se
# configura (o OCR roda na mesma máquina que ele).

# ── Nomes de modelo — para log e para a tela /provedores ─────────────────────
# Quem carrega os modelos são os serviços; aqui é só rótulo.
EMBEDDER_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Thresholds (calibráveis; ver ferramentas/calibrar_thresholds.py) ─────────
REJEITOR_THRESHOLD=0.30        # 6a: cosseno/BM25 mínimo p/ par sobreviver (recall ~99%)
RERANK_T_ACEITA=0.80           # 6b: score do reranker p/ aceitar direto
RERANK_T_REJEITA=0.30          # 6b: score do reranker p/ rejeitar direto
MIN_ITENS=1                    # "regra dos 5" DESATIVADA a pedido (ADR-016): 1 item já fecha
TOP_N=0                        # 0 = sem teto; todas as referências confirmadas por código

# ── Notificações (Fase 9) — e-mail via Resend, best-effort ───────────────────
# Etapa concluída / falhou / gate aguardando (services/notificacoes.py, runner/processo.py).
# QUEM recebe é cadastrado pela interface web (/notificacoes, CRUD de
# notificacao_destinatario) — aqui só fica a CREDENCIAL.
# Resend (e-mail): https://resend.com — API key e remetente verificado no domínio do Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
