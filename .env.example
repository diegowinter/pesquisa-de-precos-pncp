# Só o que a app precisa saber ANTES de ler o banco.
# Modelo, GPU, chaves de provedor e thresholds: configuram-se na tela (ADR-022).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pesquisa_precos

# Cifra as chaves de API no banco. Sem ela, nada que use LLM/GPU roda.
# Gerar: uv run python -c "from pesquisa_precos.db import segredo; print(segredo.gerar_chave_mestra())"
# Rotação: mova a atual p/ APP_SECRET_KEY_ANTIGA e use "re-cifrar" em /provedores.
APP_SECRET_KEY=
# APP_SECRET_KEY_ANTIGA=

# WEB_SENHA=      # vazio = login desligado
# API_TOKEN=      # protege /api

# Resend (notificação por e-mail; destinatários ficam em /notificacoes)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
